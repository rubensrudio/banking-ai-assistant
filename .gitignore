# =============================================================================
# AI Banking Assistant — .gitignore
# =============================================================================

# Environment & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Docker
.dockerignore

# ML models cache (downloaded by sentence-transformers / HuggingFace)
.cache/
~/.cache/huggingface/

# Pinecone / vector DB local data
*.index
*.faiss

# Documents / internal notes (never committed)
docs/

# Node / Angular (frontend — Phase 3)
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.env

# Azure / cloud
.azure/
*.tfstate
*.tfstate.backup
